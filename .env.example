# Copy to .env (git-ignored) and fill in what you have. run_demo.py and scripts/run_super*.py load it.
# Never commit .env. Existing shell variables take precedence over this file.

# --- Flower-served models for AgentApp tasks (explanations via Flower's runtime) ---
# flower.ai -> Profile -> Settings -> API Keys. No URL needed for Flower's own provider.
FLWR_MODEL_API_KEY=
# ENDEAVOR_MODEL=flwrlabs/endeavor-1.0     (the default)
# Only if the hackathon routes models through Nebius Token Factory instead:
# FLWR_MODEL_API_ENDPOINT=https://api.tokenfactory.tf-ca1.nebius.com/v1/responses

# --- Jev (TypeSafe System One) vote in the coordinator; without it, rules decide alone ---
TYPESAFE_API_KEY=
# JEV_MODEL=

# --- Direct model calls outside a Flower task (the injection demo, dispute drafts) ---
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Stripe TEST keys: the payment rail, required by run_demo.py (live keys are refused) ---
# (run_demo.py also mints the merchant-to-bank signing secret for the bank attestation node itself)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Optional demo settings ---
# MERCHANT_VERTICAL=W
# CHECKOUT_RATE_PER_MINUTE=30
